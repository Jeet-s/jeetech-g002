{
  "name": "game-runtime-rn",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "typecheck": "tsc --noEmit",
    "prebuild:android": "expo prebuild --platform android --no-install",
    "build:android": "cd android && ./gradlew bundleRelease",
    "validate": "tsx scripts/validate.ts",
    "playtest": "tsx scripts/playtest.ts",
    "levels": "tsx scripts/levels-report.ts"
  },
  "dependencies": {
    "@expo-google-fonts/fredoka": "^0.4.1",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@shopify/react-native-skia": "2.14.0",
    "expo": "~58.0.14",
    "expo-audio": "~58.0.9",
    "expo-build-properties": "~58.0.11",
    "expo-font": "~58.0.8",
    "expo-haptics": "~58.0.7",
    "expo-iap": "^6.1.0",
    "expo-linear-gradient": "~58.0.3",
    "expo-notifications": "~58.1.6",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-google-mobile-ads": "^17.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3",
    "tsx": "^4.20.0",
    "@types/node": "^22.0.0"
  },
  "comment": "Premium base runtime (Expo SDK 58): Skia + Reanimated + Gesture Handler, a studio-grade UI kit (src/ui), juice/particles (src/fx), audio (src/audio) and fonts. Games are built ON this kit — never with raw Views/system fonts. src/modules/{ads,iap,analytics,store} are the monetization layer and must stay."
}
